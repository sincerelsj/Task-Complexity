# Copy to .env locally. Replace only the key needed by your selected provider.
# Never commit .env. Flask itself does not need an API key.
ANTHROPIC_API_KEY=your_API_key_here
OPENAI_API_KEY=your_API_key_here
GEMINI_API_KEY=your_API_key_here
GOOGLE_API_KEY=
# Optional Gemini Vertex AI authentication (instead of an API key):
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
